{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://brip.dev/spec/0.1/schema.json",
  "title": "BRIP Document",
  "description": "Business Readable Information Protocol v0.1",
  "type": "object",
  "required": ["brip", "generatedAt", "source", "confidence"],
  "additionalProperties": true,
  "properties": {
    "brip": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source": {
      "type": "object",
      "required": ["url", "fetchedAt"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "fetchedAt": { "type": "string", "format": "date-time" },
        "pages": { "type": "array", "items": { "type": "string" } },
        "signals": { "type": "array", "items": { "type": "string" } }
      }
    },
    "organization": {
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "legalName": { "type": "string" },
        "type": { "type": "string" },
        "description": { "type": "string" },
        "url": { "type": "string" },
        "logo": { "type": "string" },
        "sameAs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "emails": { "type": "array", "items": { "type": "string" } },
        "phones": { "type": "array", "items": { "type": "string" } },
        "addresses": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "streetAddress": { "type": "string" },
              "locality": { "type": "string" },
              "region": { "type": "string" },
              "postalCode": { "type": "string" },
              "country": { "type": "string" },
              "raw": { "type": "string" }
            }
          }
        }
      }
    },
    "offerings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "price": { "type": "string" },
          "category": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "hours": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["day"],
        "properties": {
          "day": { "type": "string" },
          "opens": { "type": "string" },
          "closes": { "type": "string" }
        }
      }
    },
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string" },
          "role": { "type": "string" },
          "email": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "summary": { "type": "string" },
        "keywords": { "type": "array", "items": { "type": "string" } },
        "language": { "type": "string" }
      }
    },
    "media": {
      "type": "object",
      "properties": {
        "logo": { "type": "string" },
        "socialImage": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } }
      }
    },
    "meta": {
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "og": { "type": "object" },
        "twitter": { "type": "object" }
      }
    }
  }
}
