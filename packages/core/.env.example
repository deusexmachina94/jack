# Copy to .env for local dev. NEVER commit real secrets or private keys.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Postgres (matches infra/docker-compose.yml)
DATABASE_URL=postgres://brip:brip@localhost:5432/brip

# Local-dev signing key material is read from env / docker secrets only.
# Production uses AWS KMS via the KmsKeyProvider (Phase 2a). Never hard-code keys.
# BRIP_SIGNING_KEY_PATH=./secrets/dev-signing-key.pem
