{
  "name": "@brip/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "BRIP core — modular monolith (registry, terms, verify, tokens, audit, billing).",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src --max-warnings 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "fastify": "^5.2.0",
    "drizzle-orm": "^0.38.3",
    "fast-xml-parser": "^4.5.1",
    "postgres": "^3.4.5",
    "jose": "^5.9.6",
    "zod": "^3.24.1",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/node": "^22.10.5",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
